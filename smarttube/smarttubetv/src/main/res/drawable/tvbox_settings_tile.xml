<?xml version="1.0" encoding="utf-8"?>
<!-- Settings page tiles (TV Box style): frosted rounded row, white when focused (like the tabs/rail). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="160" android:exitFadeDuration="160">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>

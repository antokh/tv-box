<?xml version="1.0" encoding="utf-8"?>
<!-- Side panels (More options, long-press menu, settings lists): floating rounded card. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="0dp" android:insetTop="18dp" android:insetRight="18dp" android:insetBottom="18dp">
    <shape android:shape="rectangle">
        <corners android:radius="26dp" />
        <solid android:color="@color/lb_preference_decor_list_background" />
        <stroke android:width="1dp" android:color="#24FFFFFF" />
    </shape>
</inset>

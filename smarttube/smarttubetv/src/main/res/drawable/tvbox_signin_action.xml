<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in page buttons: frosted pill, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_focused="true">
        <inset android:insetTop="5dp" android:insetBottom="5dp" android:insetRight="72dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#4DFFFFFF" />
                <stroke android:width="2dp" android:color="#FFFFFFFF" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="5dp" android:insetBottom="5dp" android:insetRight="72dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#1FFFFFFF" />
            </shape>
        </inset>
    </item>
</selector>

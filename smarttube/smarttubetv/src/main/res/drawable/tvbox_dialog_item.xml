<?xml version="1.0" encoding="utf-8"?>
<!-- Rows in side panels / dialogs (TV Box style): rounded frosted highlight on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_focused="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="#40FFFFFF" />
                <stroke android:width="1dp" android:color="#59FFFFFF" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="#66FFFFFF" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>

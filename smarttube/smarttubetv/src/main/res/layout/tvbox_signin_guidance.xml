<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Box build: sign-in page, left side (Prime Video-like). Keeps the leanback ids so the
    GuidanceStylist fills them: guidance_title = the code, guidance_description = where to go,
    guidance_icon = QR code, guidance_breadcrumb = small label above.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="72dp"
    android:paddingEnd="24dp"
    android:background="@drawable/tvbox_signin_background">

    <TextView
        android:id="@+id/guidance_breadcrumb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DodoTube"
        android:textAllCaps="true"
        android:letterSpacing="0.15"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/tvbox_sign_in"
        android:textColor="#FFFFFFFF"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/guidance_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="520dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/guidance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/tvbox_signin_code"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:letterSpacing="0.06"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <ImageView
            android:id="@+id/guidance_icon"
            android:layout_width="136dp"
            android:layout_height="136dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/tvbox_signin_qr"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>

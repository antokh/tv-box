<?xml version="1.0" encoding="utf-8"?>
<!-- Small, smooth grow for the focused tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.06" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.06" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="140" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="140" />
        </set>
    </item>
</selector>
